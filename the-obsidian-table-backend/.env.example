DATABASE_URL="postgresql://user@localhost:5432/obsidian_table?schema=public"
PORT=3000
PUBLIC_BASE_URL="http://localhost:3000"

# A long random string used to sign auth cookies/tokens. Generate your own,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# Run `npm run hash-password` and paste the printed value below.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Leave blank until you complete the /admin/setup-2fa flow in the browser.
ADMIN_TOTP_SECRET=
